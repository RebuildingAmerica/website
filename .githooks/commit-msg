#!/usr/bin/env bash
set -euo pipefail

# Enforce Conventional Commits with scoped validation
# Format: type(optional-scope): description
# Types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert
# Valid scopes: defined in allowed-scopes.txt at project root

repo_root="$(git rev-parse --show-toplevel)"
commit_msg_file="$1"
formatter="$repo_root/scripts/validation/format-commit-message.sh"

if [[ -x "$formatter" ]]; then
  formatter_output="$("$formatter" "$commit_msg_file" 2>&1)"
  if [[ -n "$formatter_output" ]]; then
    echo "$formatter_output"
  fi
fi

commit_msg=$(head -1 "$commit_msg_file")
types="feat|fix|chore|refactor"

if [[ "$commit_msg" =~ ^(Merge|Revert[[:space:]]|fixup!|squash!) ]]; then
  exit 0
fi

# Check basic conventional commit format
if ! echo "$commit_msg" | grep -qE "^($types)(\(.+\))?: .+"; then
  echo "ERROR: Commit message does not follow Conventional Commits."
  echo ""
  echo "Expected format: type(scope): description"
  echo "  Types: $types"
  echo ""
  echo "Your message: $commit_msg"
  exit 1
fi

# If a scope is present, validate it against allowed-scopes.txt
scope=$(echo "$commit_msg" | sed -n 's/^[a-z]*(\([^)]*\)).*/\1/p')

if [ -n "$scope" ]; then
  scopes_file="$repo_root/allowed-scopes.txt"

  if [ ! -f "$scopes_file" ]; then
    echo "ERROR: allowed-scopes.txt file not found at project root."
    exit 1
  fi

  if ! grep -qx "$scope" "$scopes_file"; then
    echo "ERROR: Invalid scope '$scope'."
    echo ""
    echo "Valid scopes (from allowed-scopes.txt):"
    sed 's/^/  /' "$scopes_file"
    echo ""
    echo "Your message: $commit_msg"
    exit 1
  fi
fi

is_footer_line() {
  local line="$1"
  [[ "$line" =~ ^(BREAKING[[:space:]]CHANGE:|[A-Za-z][A-Za-z-]*:|Fixes[[:space:]]#|Closes[[:space:]]#|Related[[:space:]]to[[:space:]]#|Refs:|Co-Authored-By:|Co-authored-by:|Signed-off-by:|Reviewed-by:|Acked-by:) ]]
}

is_fence_line() {
  local line="$1"
  local trimmed="${line#"${line%%[![:space:]]*}"}"
  [[ "$trimmed" == '```'* || "$trimmed" == '~~~'* ]]
}

line_number=0
in_fence=0
failed=0
while IFS= read -r line || [[ -n "$line" ]]; do
  line_number=$((line_number + 1))
  if [[ $line_number -eq 1 ]]; then
    continue
  fi
  if is_fence_line "$line"; then
    if [[ $in_fence -eq 0 ]]; then
      in_fence=1
    else
      in_fence=0
    fi
    continue
  fi
  if [[ $in_fence -eq 1 || -z "$line" || "$line" == \#* ]]; then
    continue
  fi
  if is_footer_line "$line"; then
    continue
  fi
  if [[ ${#line} -gt 72 ]]; then
    if [[ $failed -eq 0 ]]; then
      echo ""
      echo "Commit body lines must be 72 characters or fewer."
    fi
    echo "  Line $line_number is ${#line} characters: $line"
    failed=1
  fi
done < "$commit_msg_file"

if [[ $failed -ne 0 ]]; then
  exit 1
fi

exit 0
