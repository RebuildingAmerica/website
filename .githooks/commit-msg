#!/bin/sh

# Enforce Conventional Commits with scoped validation
# Format: type(optional-scope): description
# Types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert
# Valid scopes: defined in allowed-scopes.txt at project root

commit_msg=$(head -1 "$1")
types="feat|fix|chore|refactor"

# Check basic conventional commit format
if ! echo "$commit_msg" | grep -qE "^($types)(\(.+\))?: .+"; then
  echo "ERROR: Commit message does not follow Conventional Commits."
  echo ""
  echo "Expected format: type(scope): description"
  echo "  Types: $types"
  echo ""
  echo "Your message: $commit_msg"
  exit 1
fi

# If a scope is present, validate it against allowed-scopes.txt
scope=$(echo "$commit_msg" | sed -n 's/^[a-z]*(\([^)]*\)).*/\1/p')

if [ -n "$scope" ]; then
  scopes_file="$(git rev-parse --show-toplevel)/allowed-scopes.txt"

  if [ ! -f "$scopes_file" ]; then
    echo "ERROR: allowed-scopes.txt file not found at project root."
    exit 1
  fi

  if ! grep -qx "$scope" "$scopes_file"; then
    echo "ERROR: Invalid scope '$scope'."
    echo ""
    echo "Valid scopes (from allowed-scopes.txt):"
    sed 's/^/  /' "$scopes_file"
    echo ""
    echo "Your message: $commit_msg"
    exit 1
  fi
fi

exit 0
